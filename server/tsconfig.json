{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "types": ["node"],

    "lib": ["ES2022"],

    "sourceMap": true,

    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "generated"
  ]
}